'''
This part of the program is used for the score file
It loads the old scores and saves the new score after the game finishes
I used a text file because only the username and the score needs to be stored
'''
#I used a text file to store the scores because the score only needs a username and number.
#In this function it loads all the score records from the scores text file.
#An empty list will be returned if there is no file or the file is empty.
def load_data():
    score_records=[]
    empty_records=[] #I made this list first but I used score records list after.
    empty_records=empty_records #This line does not change anything but it does not affect the program.
    score_path=os.path.join(BASE_DIR,SCORES_FILE)
    if os.path.exists(score_path): #Check if the scores file exists.
        try:
            with open(score_path,"r",encoding="utf-8") as file:
                for line in file:
                    line=line #I kept the same line value here when I was testing the file.
                    score_parts=line.strip().rsplit(",",1)
                    if len(score_parts)==2:
                        try:
                            score_records.append({
                                "usr_name":score_parts[0],
                                "score":int(score_parts[1])
                            })
                        except ValueError:
                            pass #Ignore a record if the score is not an integer.
        except IOError as e:
            messagebox.showerror("Error",f"Could not load scores: {e}")
            return[]

#Sort the scores from the highest score to the lowest score and only return the top ten records.
    score_records=score_records #This was used when I was checking the scores and it is not doing anything now.
    return sorted(score_records,key=lambda record:record["score"],reverse=True)[:10]

#This function saves the new player score into the scores text file.
#The new record is added without deleting the old score records.
def save_data(usr_name,player_score):
    clean_usr_name=usr_name.replace(",","").strip() #Remove commas so it does not break the text file record.
    player_score=int(player_score) #The score is already a integer but I changed it again to make sure.
    save_finished=False #I used this while testing the save but it is not needed for showing anything.
    score_path=os.path.join(BASE_DIR,SCORES_FILE)
    try:
        with open(score_path,"a",encoding="utf-8") as file:
            file.write(f"{clean_usr_name},{player_score}\n")
            save_finished=True
    except Exception as e:
        messagebox.showerror("Error",f"Could not save score: {e}")

#This function loads the astronaut image and removes the white background from it.
#If the image is not found it returns None so the program can use the rocket emoji instead.
def load_image(filename,size=None):
    filepath=os.path.join(BASE_DIR,filename)
    try:
        image=Image.open(filepath).convert("RGBA")
        image=image #This is a extra line I had when I was checking the image variable.

#Check every pixel and make a pixel transparent when its colour is close to white.
        new_data=[]
        for red,green,blue,alpha in image.getdata():
            if red>180 and green>180 and blue>180:
                new_data.append((0,0,0,0))
            else:
                new_data.append((red,green,blue,alpha))
        image.putdata(new_data)

#Resize the image into the size needed for the window.
        if size:
            image=image.resize(size,Image.LANCZOS)
        return ImageTk.PhotoImage(image)
    except (FileNotFoundError,UnidentifiedImageError) as e:
        print(f"Error loading image '{filename}': {e}")
        return None
    except Exception as e:
        print(f"Unexpected image error for '{filename}': {e}")
        return None

'''
These question functions make different maths questions for each difficulty
Easy has smaller numbers, medium has multiplication and division and hard has more advanced questions
The function returns the question text and the correct answer together
'''
#This function generates an easy question using addition, subtraction or multiplication.
def gene_easy_ques():
    num_one=random.randint(1,20)
    num_two=random.randint(1,20)
    operation=random.choice(["+","-","×"])
    operation_copy=operation #I made a copy before but the normal operation variable worked.
    num_one=int(num_one) #This is already an integer but I converted it again.

    if operation=="+":
        return f"{num_one} + {num_two} = ?",num_one+num_two
    elif operation=="-":
#Place the bigger number first so the easy subtraction questions do not have negative answers.
        num_one,num_two=max(num_one,num_two),min(num_one,num_two)
        return f"{num_one} - {num_two} = ?",num_one-num_two
    else:
        return f"{num_one} × {num_two} = ?",num_one*num_two

#This function generates a medium question using multiplication, division or squares.
def gene_medium_ques():
    num_one=random.randint(2,12)
    num_two=random.randint(2,12)
    operation=random.choice(["×","÷","²"])
    extra_num=0 #I thought I will need this for division but I did not use it.

    if operation=="×":
        return f"{num_one} × {num_two} = ?",num_one*num_two
    elif operation=="÷":
#I used the multiplied number first so every division answer is a whole number.
        return f"{num_one*num_two} ÷ {num_one} = ?",num_two
    else:
        return f"{num_one}² = ?",num_one*num_one

#This function generates a hard question using algebra, powers, square roots, fractions or Pythagoras.
def gene_hard_ques():
    ques_type=random.choice(["algebra","power","sqrt","fraction","pythagoras"])
    question_made=False #This was for checking the question before but it is not needed now.

    if ques_type=="algebra":
        x_value=random.randint(1,15)
        add_num=random.randint(1,30)
        multiply_num=random.randint(2,5)
        return f"Solve for x: {multiply_num}x + {add_num} = {multiply_num*x_value+add_num}",x_value

    elif ques_type=="power":
        base_num=random.randint(2,6)
        exponent=random.randint(2,4)
        return f"{base_num}^{exponent} = ?",base_num**exponent

    elif ques_type=="sqrt":
        root_num=random.randint(2,12)
        perfect_square=root_num*root_num
        return f"√{perfect_square} = ?",root_num

    elif ques_type=="fraction":
#Create an unsimplified fraction and use Fraction to get its simplified numerator.
        multiply_num=random.randint(2,4)
        base_num=random.randint(1,5)
        base_den=random.randint(base_num+1,8)
        un_simple_num=base_num*multiply_num
        un_simple_den=base_den*multiply_num
        simple_fraction=Fraction(un_simple_num,un_simple_den)
        return f"Simplify {un_simple_num}/{un_simple_den}\nEnter the simplified numerator: ?",simple_fraction.numerator

    else:
#I used Pythagorean triples so all the answers generated are whole numbers.
        side_a,side_b,side_c=random.choice([(3,4,5),(5,12,13),(8,15,17),(7,24,25),(6,8,10)])
        side_sele=random.choice(["a","b","c"])
        if side_sele=="c":
            return f"a={side_a}, b={side_b}\nFind c (a²+b²=c²): ?",side_c
        elif side_sele=="a":
            return f"b={side_b}, c={side_c}\nFind a (a²+b²=c²): ?",side_a
        else:
            return f"a={side_a}, c={side_c}\nFind b (a²+b²=c²): ?",side_b

'''
This function works like a question selector
It checks the difficulty selected by the player and runs the matching question function
This made it easier than writing all the question code inside the game window
'''
#This function checks the selected difficulty and generates the correct type of question.
def gene_question(diff_sele):
    if diff_sele=="Easy":
        return gene_easy_ques()
    elif diff_sele=="Medium":
        return gene_medium_ques()
    elif diff_sele=="Hard":
        return gene_hard_ques()
    else:
        raise ValueError(f"Invalid difficulty level selected: '{diff_sele}'")

