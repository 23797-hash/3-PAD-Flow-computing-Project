        star_canvas.create_oval(star_x-star_size,star_y-star_size,star_x+star_size,star_y+star_size,fill=STAR_CL,outline="")
        stars_made=stars_made+1

#This function creates the star canvas used on the loading, home, end and highscore pages.
def create_star_bg(parent):
