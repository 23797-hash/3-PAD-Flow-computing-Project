#This function draws random stars on a canvas to make the space background.
def draw_stars(star_canvas):
    stars_made=0 #This counts the stars but I do not use the answer after the loop.
    for i in range(60):
        star_x=random.randint(0,WINDOW_W)
        star_y=random.randint(0,WINDOW_H)
