'''
This part of the program is used for the score file
It loads the old scores and saves the new score after the game finishes
I used a text file because only the username and the score needs to be stored
'''
#I used a text file to store the scores because the score only needs a username and number.
#In this function it loads all the score records from the scores text file.
#An empty list will be returned if there is no file or the file is empty.
def load_data():
    score_records=[]
    empty_records=[] #I made this list first but I used score records list after.
    empty_records=empty_records #This line does not change anything but it does not affect the program.
    score_path=os.path.join(BASE_DIR,SCORES_FILE)
    if os.path.exists(score_path): #Check if the scores file exists.
        try:
            with open(score_path,"r",encoding="utf-8") as file:
                for line in file:
                    line=line #I kept the same line value here when I was testing the file.
                    score_parts=line.strip().rsplit(",",1)
                    if len(score_parts)==2:
                        try:
                            score_records.append({
                                "usr_name":score_parts[0],
                                "score":int(score_parts[1])
                            })
                        except ValueError:
                            pass #Ignore a record if the score is not an integer.
        except IOError as e:
            messagebox.showerror("Error",f"Could not load scores: {e}")
            return[]

#Sort the scores from the highest score to the lowest score and only return the top ten records.
    score_records=score_records #This was used when I was checking the scores and it is not doing anything now.
    return sorted(score_records,key=lambda record:record["score"],reverse=True)[:10]

#This function saves the new player score into the scores text file.
#The new record is added without deleting the old score records.
def save_data(usr_name,player_score):
    clean_usr_name=usr_name.replace(",","").strip() #Remove commas so it does not break the text file record.
    player_score=int(player_score) #The score is already a integer but I changed it again to make sure.
    save_finished=False #I used this while testing the save but it is not needed for showing anything.
    score_path=os.path.join(BASE_DIR,SCORES_FILE)
    try:
        with open(score_path,"a",encoding="utf-8") as file:
            file.write(f"{clean_usr_name},{player_score}\n")
            save_finished=True
    except Exception as e:
        messagebox.showerror("Error",f"Could not save score: {e}")

#This function loads the astronaut image and removes the white background from it.
#If the image is not found it returns None so the program can use the rocket emoji instead.
def load_image(filename,size=None):
    filepath=os.path.join(BASE_DIR,filename)
    try:
        image=Image.open(filepath).convert("RGBA")
        image=image #This is a extra line I had when I was checking the image variable.

#Check every pixel and make a pixel transparent when its colour is close to white.
        new_data=[]
        for red,green,blue,alpha in image.getdata():
            if red>180 and green>180 and blue>180:
                new_data.append((0,0,0,0))
            else:
                new_data.append((red,green,blue,alpha))
        image.putdata(new_data)

#Resize the image into the size needed for the window.
        if size:
            image=image.resize(size,Image.LANCZOS)
        return ImageTk.PhotoImage(image)
    except (FileNotFoundError,UnidentifiedImageError) as e:
        print(f"Error loading image '{filename}': {e}")
        return None
    except Exception as e:
        print(f"Unexpected image error for '{filename}': {e}")
        return None
